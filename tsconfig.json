{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["server.ts", "consensus/**/*.ts", "controllers/**/*.ts", "logger/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
